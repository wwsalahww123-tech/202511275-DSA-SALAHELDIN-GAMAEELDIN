#include <iostream>
#include <string>

using namespace std;

struct Member { string name; int age; };

int main() {
    // Q1: Binary Search
    int n; cout << "Enter count: "; cin >> n;
    Member f[100];
    for(int i=0; i<n; i++) cin >> f[i].name >> f[i].age;

    for(int i=0; i<n-1; i++)
        for(int j=0; j<n-i-1; j++)
            if(f[j].name > f[j+1].name) swap(f[j], f[j+1]);

    string k; cout << "Search name: "; cin >> k;
    int l=0, h=n-1, m;
    while(l <= h) {
        m = (l+h)/2;
        if(f[m].name == k) { cout << "Found, age: " << f[m].age << endl; break; }
        if(f[m].name < k) l = m+1; else h = m-1;
        if(l > h) cout << "Not found" << endl;
    }

    // Q2: Names Bubble Sort
    string s[] = {"Zuck", "Shayd", "Emely", "Amjed", "Esther", "Manar", "Anne"};
    for(int i=0; i<6; i++)
        for(int j=0; j<6-i; j++)
            if(s[j] > s[j+1]) swap(s[j], s[j+1]);
    
    cout << "\nNames: ";
    for(string x : s) cout << x << " ";

    // Q3: Numbers Bubble Sort
    int a[] = {109, 99, 23, 45, 23, 2, 5, 1};
    for(int i=0; i<7; i++)
        for(int j=0; j<7-i; j++)
            if(a[j] > a[j+1]) swap(a[j], a[j+1]);

    cout << "\nNumbers: ";
    for(int x : a) cout << x << " ";

    return 0;
}
